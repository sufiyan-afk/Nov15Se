#include <stdio.h>
int main(){
	
	int year;
	printf("enter the year");
	scanf("%d",&year);
	
	/* leap year conditions
	1.divisible by 400
	2.divisible by 4 but not divisible by 100
	*/
	
	if ((year %400 == 0) || (year %4 == 0) && (year %100 != 0)){
		printf("it is a leap");
	}
	else{
		printf("it is not a leap year");
	}
	return 0;
}
